let modo='ambos', userName='', pScores={vata:[],pitta:[],kapha:[]}, vScores={vata:[],pitta:[],kapha:[]};
let pAnswered=new Set(), vAnswered=new Set();

function mostrar(id,on){ document.getElementById(id).style.display=on?'':'none'; }

function escolher(m){
  modo=m;
  const unico=m!=='ambos';
  // barra de etapas: no questionário único ficam só 2 passos
  document.querySelectorAll('#stepsBar .step-item')[1].style.display=unico?'none':'';
  document.querySelectorAll('#stepsBar .step-line')[1].style.display=unico?'none':'';
  document.getElementById('step1l').textContent = m==='vikruti'?'Vikruti':'Prakriti';
  document.getElementById('step3c').textContent = unico?'2':'3';
  document.getElementById('subP').textContent = unico?'Sua constituição natural':'Etapa 1 de 2';
  document.getElementById('subV').textContent = unico?'Seu estado atual':'Etapa 2 de 2';
  mostrar('proxEtapa', !unico);
  document.getElementById('txtBtnP').textContent = unico?'Ver meu resultado':'Continuar para Vikruti →';
  vScores={vata:[],pitta:[],kapha:[]}; pScores={vata:[],pitta:[],kapha:[]};
  if(m==='vikruti'){
    userName = document.getElementById('nameInput').value.trim() || 'Querida';
    pScores={vata:[],pitta:[],kapha:[]}; pAnswered=new Set();
    document.getElementById('screenIntro').style.display='none';
    vScores = { vata:Array(vikrutiQ.length).fill(0), pitta:Array(vikrutiQ.length).fill(0), kapha:Array(vikrutiQ.length).fill(0) };
    vAnswered=new Set();
    document.getElementById('screenVikruti').style.display='block';
    buildQuestions('vikrutiContainer', vikrutiQ, 'v'); updateProgress('v');
    window.scrollTo({top:0,behavior:'smooth'});
  } else startPrakriti();
}

function startPrakriti(){
  userName = document.getElementById('nameInput').value.trim() || 'Querida';
  pScores = { vata:Array(prakritiQ.length).fill(0), pitta:Array(prakritiQ.length).fill(0), kapha:Array(prakritiQ.length).fill(0) };
  document.getElementById('screenIntro').style.display='none';
  document.getElementById('screenPrakriti').style.display='block';
  buildQuestions('prakritContainer', prakritiQ, 'p');
  window.scrollTo({top:0,behavior:'smooth'});
}

function goToVikruti(){
  vScores = { vata:Array(vikrutiQ.length).fill(0), pitta:Array(vikrutiQ.length).fill(0), kapha:Array(vikrutiQ.length).fill(0) };
  document.getElementById('screenPrakriti').style.display='none';
  document.getElementById('screenVikruti').style.display='block';
  document.getElementById('step1c').className='step-circle done';
  document.getElementById('step2c').className='step-circle active';
  document.getElementById('step2l').className='step-label active';
  buildQuestions('vikrutiContainer', vikrutiQ, 'v');
  window.scrollTo({top:0,behavior:'smooth'});
}

function buildQuestions(containerId, questions, prefix){
  const container = document.getElementById(containerId);
  container.innerHTML='';
  questions.forEach((q,qi)=>{
    const row = document.createElement('div');
    row.className='question-row'; row.id=`${prefix}row-${qi}`;
    const lbl=document.createElement('div'); lbl.className='q-label';
    lbl.innerHTML=`<span>${q.label}</span>`; row.appendChild(lbl);
    ['vata','pitta','kapha'].forEach(dosha=>{
      const opt=document.createElement('div'); opt.className=`q-option ${dosha}`;
      const txt=document.createElement('div'); txt.className='q-option-text'; txt.textContent=q[dosha]; opt.appendChild(txt);
      const btns=document.createElement('div'); btns.className='score-btns';
      [0,1,2,3].forEach(val=>{
        const btn=document.createElement('button'); btn.className='score-btn'; btn.textContent=val;
        btn.onclick=()=>selectScore(qi,dosha,val,btn,opt,prefix);
        btns.appendChild(btn);
      });
      opt.appendChild(btns); row.appendChild(opt);
    });
    container.appendChild(row);
  });
}

function selectScore(qi,dosha,val,btn,optEl,prefix){
  optEl.querySelectorAll('.score-btn').forEach(b=>b.classList.remove('selected'));
  btn.classList.add('selected');
  if(prefix==='p') pScores[dosha][qi]=val; else vScores[dosha][qi]=val;
  checkAnswered(qi,prefix);
  updateProgress(prefix);
}

function checkAnswered(qi,prefix){
  const row=document.getElementById(`${prefix}row-${qi}`);
  let has=false;
  row.querySelectorAll('.q-option').forEach(opt=>{ if(opt.querySelector('.score-btn.selected')) has=true; });
  if(has){ (prefix==='p'?pAnswered:vAnswered).add(qi); row.classList.add('answered'); row.classList.remove('missing'); }
}

function updateProgress(prefix){
  const answered=prefix==='p'?pAnswered:vAnswered;
  const total=prefix==='p'?prakritiQ.length:vikrutiQ.length;
  const done=answered.size;
  document.getElementById(`${prefix}Progress`).textContent=`${done} de ${total} respondidas`;
  document.getElementById(`${prefix}Fill`).style.width=`${(done/total)*100}%`;
  const btn=document.getElementById(prefix==='p'?'btnPrakriti':'btnVikruti');
  const note=document.getElementById(prefix==='p'?'pNote':'vNote');
  note.classList.remove('alerta');
  if(done===total){ note.textContent='Pronto! Clique para continuar.'; }
  else { note.textContent=`Faltam ${total-done} pergunta${total-done>1?'s':''}`; }
}

// O botão sempre funciona: se faltar resposta, leva até a primeira pergunta pulada
function tentarAvancar(prefix){
  const answered=prefix==='p'?pAnswered:vAnswered;
  const total=prefix==='p'?prakritiQ.length:vikrutiQ.length;
  if(answered.size===total){ (prefix==='p'&&modo==='ambos')?goToVikruti():showResult(); return; }
  let primeira=null;
  for(let i=0;i<total;i++){
    if(!answered.has(i)){ const row=document.getElementById(`${prefix}row-${i}`); row.classList.add('missing'); if(!primeira) primeira=row; }
  }
  const falta=total-answered.size;
  const note=document.getElementById(prefix==='p'?'pNote':'vNote');
  note.classList.add('alerta');
  note.textContent=`Falta${falta>1?'m':''} ${falta} pergunta${falta>1?'s':''}, marcada${falta>1?'s':''} em destaque. Em cada linha, marque pelo menos uma coluna.`;
  primeira.scrollIntoView({behavior:'smooth',block:'center'});
}

function getDoshaType(v,p,k){
  const max=Math.max(v,p,k), thr=max*0.75;
  const isV=v>=thr,isP=p>=thr,isK=k>=thr;
  const c=[isV,isP,isK].filter(Boolean).length;
  if(c===3) return 'tridoshic';
  if(c===2){ if(isV&&isP) return 'vataPitta'; if(isP&&isK) return 'pittaKapha'; return 'vataKapha'; }
  if(v===max) return 'vata'; if(p===max) return 'pitta'; return 'kapha';
}

// Nível de cada dosha na Vikruti, pela soma dos sintomas (máximo = perguntas x 3)
function nivelVikruti(score){
  const pct=score/(vikrutiQ.length*3);
  if(pct>0.5)  return {key:'elevado',  txt:'Elevado'};
  if(pct>=0.3) return {key:'moderado', txt:'Pede atenção'};
  return {key:'baixo', txt:'Equilibrado'};
}
const PRAKRITI_DOSHAS={ vata:['vata'], pitta:['pitta'], kapha:['kapha'], vataPitta:['vata','pitta'], pittaKapha:['pitta','kapha'], vataKapha:['vata','kapha'], tridoshic:['vata','pitta','kapha'] };

function showResult(){
  const pV=pScores.vata.reduce((a,b)=>a+b,0), pP=pScores.pitta.reduce((a,b)=>a+b,0), pK=pScores.kapha.reduce((a,b)=>a+b,0);
  const vV=vScores.vata.reduce((a,b)=>a+b,0), vP=vScores.pitta.reduce((a,b)=>a+b,0), vK=vScores.kapha.reduce((a,b)=>a+b,0);

  document.getElementById('screenVikruti').style.display='none';
  document.getElementById('screenPrakriti').style.display='none';
  document.getElementById('screenResult').style.display='block';
  document.getElementById('step1c').className='step-circle done';
  document.getElementById('step2c').className='step-circle done';
  document.getElementById('step3c').className='step-circle active';
  document.getElementById('step3l').className='step-label active';

  document.getElementById('rName').textContent=userName;
  const temP=modo!=='vikruti', temV=modo!=='prakriti';
  mostrar('cardP',temP); mostrar('blocoP',temP); mostrar('cardV',temV); mostrar('blocoDeseq',temV); mostrar('blocoV',temV);
  const comp=document.getElementById('comparacao');
  comp.style.gridTemplateColumns = (temP&&temV)?'':'1fr'; comp.style.maxWidth=(temP&&temV)?'':'420px'; comp.style.margin=(temP&&temV)?'':'0 auto 28px';
  document.getElementById('rGreeting').textContent = modo==='ambos'?'Seu mapa ayurvédico completo':(modo==='prakriti'?'Sua constituição natural':'Seu estado atual');
  mostrar('rTagline', modo==='ambos');
  document.getElementById('rPV').textContent=pV; document.getElementById('rPP').textContent=pP; document.getElementById('rPK').textContent=pK;
  document.getElementById('rVV').textContent=vV; document.getElementById('rVP').textContent=vP; document.getElementById('rVK').textContent=vK;

  const pType=getDoshaType(pV,pP,pK), pInfo=doshaData[pType];
  document.getElementById('rPName').textContent=pInfo.name; document.getElementById('rPName').style.color=pInfo.color;
  document.getElementById('rPSub').textContent=pInfo.sub;

  // Vikruti: cada dosha recebe um nível pelos sintomas, sem escolher um vencedor
  const DOSHAS=['vata','pitta','kapha'];
  const vTot={vata:vV,pitta:vP,kapha:vK};
  const niveis={}; DOSHAS.forEach(d=>niveis[d]=nivelVikruti(vTot[d]));
  let foco=DOSHAS.filter(d=>niveis[d].key==='elevado'), grau='elevado';
  if(!foco.length){ foco=DOSHAS.filter(d=>niveis[d].key==='moderado'); grau='moderado'; }
  foco.sort((a,b)=>vTot[b]-vTot[a]);
  const nomes=foco.map(d=>doshaData[d].name);
  const juntar=arr=>arr.length>1?arr.slice(0,-1).join(', ')+' e '+arr[arr.length-1]:arr[0];

  const rVName=document.getElementById('rVName'), rVSub=document.getElementById('rVSub');
  if(!foco.length){ rVName.textContent='Em equilíbrio'; rVName.style.color='var(--green)'; rVSub.textContent='Sem sinais importantes agora'; }
  else { rVName.textContent=juntar(nomes); rVName.style.color=doshaData[foco[0]].color; rVSub.textContent=grau==='elevado'?'Em desequilíbrio':'Pedindo atenção'; }
  document.getElementById('rVLevels').innerHTML=DOSHAS.map(d=>`<div class="v-level"><span style="color:${doshaData[d].color}">${doshaData[d].name}</span><span class="lvl-pill lvl-${niveis[d].key}">${niveis[d].txt}</span></div>`).join('');

  // Banner: a Prakriti só ajuda a interpretar o que a Vikruti mostrou
  const deseq=document.getElementById('rDeseq');
  const natural = temP ? PRAKRITI_DOSHAS[pType] : null;
  if(!foco.length){
    deseq.className='desequilibrio equilibrado';
    deseq.innerHTML=`<h3 style="color:var(--green)">✦ Em equilíbrio no momento</h3><p>Os seus sintomas dos últimos três meses estão baixos em Vata, Pitta e Kapha. O seu corpo e a sua mente estão conseguindo manter o equilíbrio, então continue com os cuidados da sua rotina para preservar esse estado.</p>`;
  } else {
    deseq.className='desequilibrio desequilibrado';
    const titulo=grau==='elevado'?'⚠ Desequilíbrio identificado':'✦ Pontos de atenção';
    const abre=grau==='elevado'
      ?`<p>Os seus sintomas atuais mostram <strong>${juntar(nomes)}</strong> ${foco.length>1?'elevados':'elevado'}.</p>`
      :`<p>Nenhum dosha está muito alto, mas <strong>${juntar(nomes)}</strong> ${foco.length>1?'começam':'começa'} a dar sinais.</p>`;
    const frases=!natural ? `<p>${foco.length>1?'São eles que estão':'É ele que está'} pedindo mais cuidado neste momento.</p>` : foco.map(d=>{
      const n=`<strong style="color:${doshaData[d].color}">${doshaData[d].name}</strong>`;
      if(natural.includes(d)) return `<p>${n} faz parte da sua constituição natural, então esse é o caminho mais comum para você sair do equilíbrio. ${grau==='elevado'?'É a sua própria tendência que se agravou e agora pede cuidado.':'É a sua própria tendência começando a se agravar e pedindo cuidado.'}</p>`;
      return `<p>${n} não é predominante na sua constituição natural, então esse ${grau==='elevado'?'desequilíbrio':'aumento'} vem de fora da sua natureza, geralmente pela rotina, pela alimentação, pela estação do ano ou pela fase de vida, e merece mais atenção.</p>`;
    }).join('');
    deseq.innerHTML=`<h3 style="color:#B8860B">${titulo}</h3>${abre}${frases}`;
  }

  document.getElementById('rPDesc').textContent=pInfo.desc;

  const pQ=document.getElementById('rPQualities'); pQ.innerHTML='';
  pInfo.qualities.forEach(q=>{ const t=document.createElement('span'); t.className='quality-tag'; t.textContent=q; t.style.color=pInfo.color; t.style.borderColor=pInfo.color; t.style.background=pInfo.color+'18'; pQ.appendChild(t); });

  document.getElementById('rVDesc').innerHTML = foco.length
    ? foco.map(d=>`<p>${doshaData[d].descV}</p>`).join('')
    : `<p>Nenhum dosha está com sintomas elevados nos últimos três meses. Isso não quer dizer que não exista nenhum sinal, e sim que eles estão em níveis que o próprio corpo consegue equilibrar.</p>`;

  window.scrollTo({top:0,behavior:'smooth'});

  // Enviar resultado para Formspree
  fetch('https://formspree.io/f/mreowzwq', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
    body: JSON.stringify({
      nome: userName,
      questionario: modo==='ambos'?'Prakriti e Vikruti':(modo==='prakriti'?'Só Prakriti':'Só Vikruti'),
      prakriti: temP?pInfo.name:'(não fez)',
      prakriti_vata: temP?pV:'-', prakriti_pitta: temP?pP:'-', prakriti_kapha: temP?pK:'-',
      vikruti_vata: temV?`${vV} (${niveis.vata.txt})`:'-', vikruti_pitta: temV?`${vP} (${niveis.pitta.txt})`:'-', vikruti_kapha: temV?`${vK} (${niveis.kapha.txt})`:'-',
      equilibrio: !temV ? '(não fez)' : !foco.length ? 'Em equilíbrio' : (grau==='elevado' ? `Desequilíbrio: ${juntar(nomes)} elevado` : `Atenção: ${juntar(nomes)}`),
      _subject: `${modo==='ambos'?'Dosha':(modo==='prakriti'?'Prakriti':'Vikruti')} de ${userName} · Prana Astral`
    })
  }).catch(()=>{});
}

function restart(){
  pAnswered=new Set(); vAnswered=new Set();
  ['step1c','step2c','step3c'].forEach((id,i)=>{ document.getElementById(id).className='step-circle'+(i===0?' active':''); });
  ['step1l','step2l','step3l'].forEach((id,i)=>{ document.getElementById(id).className='step-label'+(i===0?' active':''); });
  document.getElementById('screenResult').style.display='none';
  document.getElementById('screenIntro').style.display='block';
  document.getElementById('nameInput').value='';
  window.scrollTo({top:0,behavior:'smooth'});
}
</script>


