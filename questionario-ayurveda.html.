<html lang="pt-BR"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Questionário Ayurvédico · Prana Astral</title>
<link href="./Questionário Ayurvédico · Prana Astral novo_files/css2" rel="stylesheet">
<meta property="og:title" content="Questionário Ayurvédico · Prana Astral">
<meta property="og:description" content="Questionário ayurvédico de constituição e estado atual, por Jana Gusmão.">
<meta property="og:type" content="website">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --cream:   #F8F5EF;
    --cream2:  #F0EBE1;
    --purple:  #3D3558;
    --purple2: #6B5E9A;
    --purpleL: #A09AC0;
    --green:   #3A6B4E;
    --green2:  #5C8C6A;
    --greenL:  #A8CCA8;
    --greenLL: #EAF2EA;
    --vata:    #7B9BAF;
    --pitta:   #C47B4A;
    --kapha:   #5C8C6A;
    --text:    #2C2C2C;
    --gray:    #6A6A6A;
    --white:   #FFFFFF;
    --border:  #E0DAD0;
  }
  body { background: var(--cream); font-family: 'EB Garamond', Georgia, serif; color: var(--text); min-height: 100vh; }

  /* HEADER */
  .header { background: var(--white); border-bottom: 1px solid var(--border); padding: 16px 24px; display: flex; align-items: center; justify-content: center; gap: 14px; position: sticky; top: 0; z-index: 100; }
  .header-brand { font-family: 'Cormorant Garamond', serif; font-size: 19px; font-weight: 400; color: var(--purple); letter-spacing: 0.06em; }
  .header-sub { font-family: 'Cormorant SC', serif; font-size: 9px; font-weight: 300; color: var(--purpleL); letter-spacing: 0.22em; }

  /* STEPS INDICATOR */
  .steps-bar { display: flex; justify-content: center; align-items: center; gap: 0; padding: 18px 20px 0; }
  .step-item { display: flex; align-items: center; gap: 0; }
  .step-circle { width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: 'Cormorant SC', serif; font-size: 11px; border: 1.5px solid var(--border); background: var(--white); color: var(--purpleL); transition: all 0.3s; }
  .step-circle.active { background: var(--purple); border-color: var(--purple); color: var(--white); }
  .step-circle.done { background: var(--green2); border-color: var(--green2); color: var(--white); }
  .step-label { font-family: 'Cormorant SC', serif; font-size: 9px; letter-spacing: 0.15em; color: var(--purpleL); margin-left: 6px; }
  .step-label.active { color: var(--purple); }
  .step-line { width: 40px; height: 1px; background: var(--border); margin: 0 10px; }

  /* MAIN */
  .main { max-width: 800px; margin: 0 auto; padding: 32px 20px 80px; }

  /* CARDS */
  .card { background: var(--white); border: 1px solid var(--border); border-radius: 4px; padding: 40px 44px; margin-bottom: 24px; }
  .card-title { font-family: 'Cormorant Garamond', serif; font-size: 28px; font-weight: 400; color: var(--purple); letter-spacing: 0.04em; margin-bottom: 6px; text-align: center; }
  .card-sub { font-family: 'Cormorant SC', serif; font-size: 10px; letter-spacing: 0.2em; color: var(--purpleL); text-align: center; margin-bottom: 20px; }

  /* ORIENTATION BOX */
  .orientation-box { background: var(--greenLL); border-left: 3px solid var(--green2); border-radius: 0 3px 3px 0; padding: 20px 24px; margin-bottom: 28px; }
  .orientation-box .ori-title { font-family: 'Cormorant SC', serif; font-size: 10px; letter-spacing: 0.2em; color: var(--green); margin-bottom: 10px; }
  .orientation-box p { font-size: 15px; line-height: 1.85; color: #4A5A4A; }
  .orientation-box .ori-highlight { font-style: italic; font-weight: 500; color: var(--green); }

  /* VIKRUTI ORIENTATION */
  .vikruti-box { background: #F5F0FF; border-left: 3px solid var(--purple2); border-radius: 0 3px 3px 0; padding: 20px 24px; margin-bottom: 28px; }
  .vikruti-box .ori-title { font-family: 'Cormorant SC', serif; font-size: 10px; letter-spacing: 0.2em; color: var(--purple); margin-bottom: 10px; }
  .vikruti-box p { font-size: 15px; line-height: 1.85; color: #4A4560; }
  .vikruti-box .ori-highlight { font-style: italic; font-weight: 500; color: var(--purple2); }

  /* NAME INPUT */
  .name-wrap { text-align: center; margin-bottom: 8px; }
  .name-wrap label { font-family: 'Cormorant SC', serif; font-size: 10px; letter-spacing: 0.18em; color: var(--purple); display: block; margin-bottom: 8px; }
  .name-input { width: 100%; max-width: 320px; padding: 12px 18px; border: 1px solid #D0CAC0; border-radius: 2px; background: var(--cream); font-family: 'EB Garamond', serif; font-size: 17px; color: var(--text); text-align: center; outline: none; transition: border-color 0.2s; }
  .name-input:focus { border-color: var(--green2); }
  .name-input::placeholder { color: #B0A898; }

  /* PROGRESS */
  .progress-wrap { margin-bottom: 24px; }
  .progress-label { font-family: 'Cormorant SC', serif; font-size: 9px; letter-spacing: 0.16em; color: var(--purpleL); text-align: right; margin-bottom: 5px; }
  .progress-bar { height: 2px; background: var(--border); border-radius: 2px; overflow: hidden; }
  .progress-fill { height: 100%; border-radius: 2px; transition: width 0.4s ease; }
  .fill-prakriti { background: linear-gradient(90deg, var(--green2), var(--purple2)); }
  .fill-vikruti  { background: linear-gradient(90deg, var(--purple2), var(--pitta)); }

  /* COLUMN HEADERS */
  .col-headers { display: grid; grid-template-columns: 175px 1fr 1fr 1fr; gap: 8px; margin-bottom: 6px; padding: 0 2px; }
  .col-header { font-family: 'Cormorant Garamond', serif; font-size: 18px; font-weight: 500; text-align: center; padding: 8px 0; }
  .col-vata  { color: var(--vata); }
  .col-pitta { color: var(--pitta); }
  .col-kapha { color: var(--kapha); }

  /* QUESTION ROW */
  .question-row { background: var(--white); border: 1px solid #EAE4DA; border-radius: 3px; margin-bottom: 7px; display: grid; grid-template-columns: 175px 1fr 1fr 1fr; overflow: hidden; transition: border-color 0.2s, box-shadow 0.2s; }
  .question-row:hover { box-shadow: 0 2px 10px rgba(61,53,88,0.06); }
  .question-row.answered { border-color: var(--greenL); }
  .question-row.missing { border-color: #D9967A; box-shadow: 0 0 0 3px #F6DCCF; }
  .submit-note.alerta { color: #A0452A; font-style: normal; }
  .q-label { background: var(--cream2); padding: 16px 14px; display: flex; align-items: center; border-right: 1px solid #EAE4DA; }
  .q-label span { font-family: 'Cormorant Garamond', serif; font-weight: 500; font-size: 14px; color: var(--purple); line-height: 1.3; }
  .q-option { padding: 12px 8px; border-right: 1px solid #EAE4DA; display: flex; flex-direction: column; align-items: center; gap: 8px; transition: background 0.15s; }
  .q-option:last-child { border-right: none; }
  .q-option-text { font-size: 12.5px; line-height: 1.45; color: #555; text-align: center; font-style: italic; }
  .score-btns { display: flex; gap: 4px; flex-wrap: wrap; justify-content: center; }
  .score-btn { width: 26px; height: 26px; border-radius: 50%; border: 1.5px solid #D0CAC0; background: var(--cream); font-family: 'Cormorant Garamond', serif; font-size: 12px; color: var(--gray); cursor: pointer; transition: all 0.15s; display: flex; align-items: center; justify-content: center; }
  .score-btn:hover { border-color: var(--purple2); color: var(--purple); }
  .q-option.vata  .score-btn.selected { background: var(--vata);  border-color: var(--vata);  color: #fff; }
  .q-option.pitta .score-btn.selected { background: var(--pitta); border-color: var(--pitta); color: #fff; }
  .q-option.kapha .score-btn.selected { background: var(--kapha); border-color: var(--kapha); color: #fff; }

  /* BUTTONS */
  .btn-primary { display: inline-block; background: var(--purple); color: var(--white); font-family: 'Cormorant SC', serif; font-size: 12px; letter-spacing: 0.22em; padding: 14px 38px; border: none; border-radius: 2px; cursor: pointer; transition: background 0.2s; }
  .btn-primary:hover { background: var(--green); }
  .btn-primary:disabled { background: #C0BAB0; cursor: not-allowed; }
  .btn-green { background: var(--green); }
  .btn-green:hover { background: var(--purple); }
  .btn-outline { background: transparent; color: var(--purple); border: 1px solid var(--purple); font-family: 'Cormorant SC', serif; font-size: 11px; letter-spacing: 0.2em; padding: 12px 28px; border-radius: 2px; cursor: pointer; transition: all 0.2s; }
  .btn-outline:hover { background: var(--purple); color: var(--white); }
  .submit-wrap { text-align: center; margin-top: 28px; }
  .submit-note { font-size: 13px; color: var(--purpleL); font-style: italic; margin-top: 10px; }

  /* RESULT */
  .result-header { text-align: center; margin-bottom: 32px; }
  .result-greeting { font-family: 'Cormorant SC', serif; font-size: 10px; letter-spacing: 0.22em; color: var(--purpleL); margin-bottom: 8px; }
  .result-name { font-family: 'Cormorant Garamond', serif; font-size: 34px; font-weight: 300; font-style: italic; color: var(--purple); margin-bottom: 6px; }
  .result-tagline { font-size: 15px; font-style: italic; color: var(--gray); }

  /* COMPARISON GRID */
  .comparison { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 28px; }
  .comp-card { border: 1px solid var(--border); border-radius: 3px; padding: 28px 24px; text-align: center; }
  .comp-card-label { font-family: 'Cormorant SC', serif; font-size: 9px; letter-spacing: 0.22em; color: var(--purpleL); margin-bottom: 12px; }
  .comp-scores { display: flex; justify-content: center; gap: 20px; margin-bottom: 16px; }
  .comp-score { text-align: center; }
  .comp-score-num { font-family: 'Cormorant Garamond', serif; font-size: 32px; font-weight: 300; line-height: 1; }
  .comp-score-lbl { font-family: 'Cormorant SC', serif; font-size: 9px; letter-spacing: 0.16em; margin-top: 3px; }
  .s-vata  { color: var(--vata); }
  .s-pitta { color: var(--pitta); }
  .s-kapha { color: var(--kapha); }
  .comp-dosha-name { font-family: 'Cormorant Garamond', serif; font-size: 24px; font-weight: 400; letter-spacing: 0.04em; margin-bottom: 4px; }
  .comp-dosha-sub  { font-family: 'Cormorant SC', serif; font-size: 9px; letter-spacing: 0.18em; color: var(--purpleL); }

  /* DESEQUILIBRIO BANNER */
  .desequilibrio { border-radius: 3px; padding: 20px 24px; margin-bottom: 24px; text-align: center; }
  .desequilibrio.equilibrado { background: var(--greenLL); border: 1px solid var(--greenL); }
  .desequilibrio.desequilibrado { background: #FFF8F0; border: 1px solid #E8C890; }
  .desequilibrio h3 { font-family: 'Cormorant SC', serif; font-size: 11px; letter-spacing: 0.18em; margin-bottom: 8px; }
  .desequilibrio p  { font-size: 15px; line-height: 1.8; color: var(--gray); max-width: 560px; margin: 0 auto; }

  /* NIVEIS VIKRUTI */
  .v-levels { display: flex; flex-direction: column; gap: 7px; margin-top: 16px; text-align: left; }
  .v-level { display: flex; justify-content: space-between; align-items: center; font-size: 15px; padding: 0 6px; }
  .lvl-pill { font-family: 'Cormorant SC', serif; font-size: 10px; letter-spacing: 0.12em; padding: 3px 11px; border-radius: 20px; }
  .lvl-baixo { background: var(--greenLL); color: var(--green); }
  .lvl-moderado { background: #FFF4E0; color: #9A6B12; }
  .lvl-elevado { background: #FBE6DE; color: #A0452A; }
  .desc-block p + p { margin-top: 12px; }
  .desequilibrio p + p { margin-top: 10px; }
  .tips-box + .tips-box { margin-top: 14px; }

  .escolhas { display: flex; flex-direction: column; gap: 10px; max-width: 360px; margin: 0 auto; }
  .escolha { background: var(--white); border: 1px solid var(--purple); color: var(--purple); font-family: 'EB Garamond', serif; font-size: 17px; padding: 14px 18px; border-radius: 3px; cursor: pointer; text-align: center; line-height: 1.35; transition: all 0.2s; }
  .escolha small { display: block; font-size: 13px; font-style: italic; color: var(--gray); margin-top: 2px; }
  .escolha:hover { background: var(--purple); color: var(--white); }
  .escolha:hover small { color: #E8E2F2; }

  /* DESC BLOCK */
  .desc-block { margin-bottom: 20px; }
  .desc-block h3 { font-family: 'Cormorant SC', serif; font-size: 10px; letter-spacing: 0.2em; color: var(--purpleL); margin-bottom: 10px; }
  .desc-block p { font-size: 16px; line-height: 1.85; color: var(--gray); }

  .qualities-row { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 24px; }
  .quality-tag { padding: 5px 14px; border-radius: 20px; font-size: 13px; font-style: italic; border: 1px solid; }

  .tips-box { background: var(--cream); border-radius: 3px; padding: 22px 26px; border-left: 2px solid; }
  .tips-box h3 { font-family: 'Cormorant SC', serif; font-size: 10px; letter-spacing: 0.2em; margin-bottom: 12px; }
  .tips-box ul { list-style: none; display: flex; flex-direction: column; gap: 7px; }
  .tips-box li { font-size: 14.5px; line-height: 1.5; color: var(--gray); padding-left: 16px; position: relative; }
  .tips-box li::before { content: '·'; position: absolute; left: 0; font-size: 20px; line-height: 1; top: 0; }

  /* DIVIDER */
  .fancy-divider { display: flex; align-items: center; gap: 12px; margin: 28px 0; }
  .fancy-divider-line { flex:1; height: 0.5px; background: var(--border); }
  .fancy-divider-dot  { width: 4px; height: 4px; border-radius: 50%; background: var(--purpleL); }

  /* FOOTER */
  .footer { text-align: center; padding: 24px; font-family: 'Cormorant SC', serif; font-size: 9px; letter-spacing: 0.18em; color: var(--purpleL); border-top: 1px solid var(--border); margin-top: 40px; }

  /* MOBILE */
  @media (max-width: 600px) {
    .col-headers, .question-row { grid-template-columns: 1fr; }
    .col-headers { display: none; }
    .q-label { border-right: none; border-bottom: 1px solid #EAE4DA; }
    .q-option { border-right: none; border-bottom: 1px solid #EAE4DA; }
    .q-option:last-child { border-bottom: none; }
    .card { padding: 24px 18px; }
    .comparison { grid-template-columns: 1fr; }
    .q-option-text { font-size: 15px; }
    .q-label span { font-size: 16px; }
    .score-btn { width: 34px; height: 34px; font-size: 14px; }
  }
</style>
</head>
<body>

<header class="header">
  <div>
    <img src="data:image/png;base64," alt="Prana Astral" style="height:46px;width:auto;display:block">
  </div>
  <div>
    <div class="header-brand">Prana Astral</div>
    <div class="header-sub">Jana Gusmão · Ayurveda</div>
  </div>
</header>

<div class="main">

  <!-- STEPS -->
  <div class="steps-bar" id="stepsBar">
    <div class="step-item">
      <div class="step-circle active" id="step1c">1</div>
      <div class="step-label active" id="step1l">Prakriti</div>
    </div>
    <div class="step-line"></div>
    <div class="step-item">
      <div class="step-circle" id="step2c">2</div>
      <div class="step-label" id="step2l">Vikruti</div>
    </div>
    <div class="step-line"></div>
    <div class="step-item">
      <div class="step-circle" id="step3c">3</div>
      <div class="step-label" id="step3l">Resultado</div>
    </div>
  </div>

  <!-- ══ INTRO ══ -->
  <div id="screenIntro">
    <br>
    <div class="card" style="text-align:center">
      <div class="card-sub">Constituição Psico-física · Ayurveda</div>
      <h1 class="card-title">Prakriti &amp; Vikruti</h1>
      <p style="font-size:16px; line-height:1.85; color:var(--gray); max-width:520px; margin:0 auto 28px">
        Escolha o questionário que você vai fazer. A <em>Prakriti</em> mostra a sua constituição de nascença, e a <em>Vikruti</em> mostra como você está agora e se há desequilíbrio a cuidar.
      </p>
      <div class="name-wrap">
        <label for="nameInput">Seu nome</label>
        <input type="text" id="nameInput" class="name-input" placeholder="Digite seu nome" maxlength="60">
      </div>
      <br>
      <div class="escolhas">
        <button class="escolha" onclick="escolher('ambos')">Prakriti e Vikruti<small>Constituição e estado atual</small></button>
        <button class="escolha" onclick="escolher('prakriti')">Só Prakriti<small>Constituição de nascença</small></button>
        <button class="escolha" onclick="escolher('vikruti')">Só Vikruti<small>Estado atual e desequilíbrio</small></button>
      </div>
    </div>
  </div>

  <!-- ══ PRAKRITI ══ -->
  <div id="screenPrakriti" style="display:none">
    <br>
    <div class="card">
      <div class="card-sub" id="subP">Etapa 1 de 2</div>
      <h2 class="card-title">Prakriti</h2>
      <div class="orientation-box">
        <div class="ori-title">Como responder</div>
        <p>
          Esta etapa é sobre <span class="ori-highlight">quem você sempre foi</span>, sua constituição natural de nascença, que não muda ao longo da vida.<br><br>
          Pense em como você era <span class="ori-highlight">quando jovem, saudável, sem estar em período de stress ou doença</span>. Se tiver dúvida, lembre-se de como era dos seus 15 aos 25 anos. Não responda como você está hoje<span id="proxEtapa">, isso virá na próxima etapa</span>.<br><br>
          Para cada característica, marque de <strong>0</strong> (não me identifica) a <strong>3</strong> (me identifica muito) nas três colunas.
        </p>
      </div>
      <div class="progress-wrap">
        <div class="progress-label" id="pProgress">0 de 21 respondidas</div>
        <div class="progress-bar"><div class="progress-fill fill-prakriti" id="pFill" style="width:0%"></div></div>
      </div>
      <div class="col-headers">
        <div></div>
        <div class="col-header col-vata">Vata</div>
        <div class="col-header col-pitta">Pitta</div>
        <div class="col-header col-kapha">Kapha</div>
      </div>
      <div id="prakritContainer"></div>
      <div class="submit-wrap">
        <button class="btn-primary btn-green" id="btnPrakriti" onclick="tentarAvancar('p')"><span id="txtBtnP">Continuar para Vikruti →</span></button>
        <div class="submit-note" id="pNote">Responda todas as perguntas para continuar</div>
      </div>
    </div>
  </div>

  <!-- ══ VIKRUTI ══ -->
  <div id="screenVikruti" style="display:none">
    <br>
    <div class="card">
      <div class="card-sub" id="subV">Etapa 2 de 2</div>
      <h2 class="card-title">Vikruti</h2>
      <div class="vikruti-box">
        <div class="ori-title">Como responder</div>
        <p>
          Agora responda sobre <span class="ori-highlight">como você está nos últimos 3 meses</span>, seu estado atual, físico e emocional.<br><br>
          Não pense no que era antes. Pense em <span class="ori-highlight">como você tem se sentido recentemente</span>, sua pele agora, seu sono essa semana, seu humor esse mês. Se um sintoma aparece só às vezes, marque 1 ou 2.<br><br>
          Para cada característica, marque de <strong>0</strong> (não está acontecendo) a <strong>3</strong> (está acontecendo muito).
        </p>
      </div>
      <div class="progress-wrap">
        <div class="progress-label" id="vProgress">0 de 25 respondidas</div>
        <div class="progress-bar"><div class="progress-fill fill-vikruti" id="vFill" style="width:0%"></div></div>
      </div>
      <div class="col-headers">
        <div></div>
        <div class="col-header col-vata">Vata</div>
        <div class="col-header col-pitta">Pitta</div>
        <div class="col-header col-kapha">Kapha</div>
      </div>
      <div id="vikrutiContainer"></div>
      <div class="submit-wrap">
        <button class="btn-primary" id="btnVikruti" onclick="tentarAvancar('v')">Ver meu resultado completo</button>
        <div class="submit-note" id="vNote">Responda todas as perguntas para ver o resultado</div>
      </div>
    </div>
  </div>

  <!-- ══ RESULTADO ══ -->
  <div id="screenResult" style="display:none">
    <br>
    <div class="card">
      <div class="result-header">
        <div class="result-greeting" id="rGreeting">Seu mapa ayurvédico completo</div>
        <div class="result-name" id="rName"></div>
        <div class="result-tagline" id="rTagline">Prakriti &amp; Vikruti · Constituição e Estado Atual</div>
      </div>

      <!-- Comparison -->
      <div class="comparison" id="comparacao">
        <div class="comp-card" id="cardP">
          <div class="comp-card-label">Prakriti · Constituição de Nascença</div>
          <div class="comp-scores">
            <div class="comp-score"><div class="comp-score-num s-vata" id="rPV"></div><div class="comp-score-lbl s-vata">Vata</div></div>
            <div class="comp-score"><div class="comp-score-num s-pitta" id="rPP"></div><div class="comp-score-lbl s-pitta">Pitta</div></div>
            <div class="comp-score"><div class="comp-score-num s-kapha" id="rPK"></div><div class="comp-score-lbl s-kapha">Kapha</div></div>
          </div>
          <div class="comp-dosha-name" id="rPName"></div>
          <div class="comp-dosha-sub" id="rPSub"></div>
        </div>
        <div class="comp-card" id="cardV">
          <div class="comp-card-label">Vikruti · Estado Atual</div>
